<?xml version="1.0" encoding="UTF-8"?>

<!--
    FazConta Calculator UI (JavaFX)

    This FXML defines the complete user interface for the FazConta calculator.

    Architecture role:
    - View layer in MVC pattern
    - Delegates all interaction logic to FazContaController
    - Stateless layout definition

    Layout strategy:
    - GridPane-based 4x5 calculator grid
    - Fixed column widths for alignment consistency
    - Display spans full width (4 columns)
    - Buttons mapped 1:1 to controller input handler
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.pororoca.controller.FazContaController"
          hgap="10"
          vgap="10"
          styleClass="root">

    <!--
        Display field:
        - Read-only output of calculator state
        - Spans all 4 columns of grid
        - Fixed height for UI consistency
    -->
    <TextField fx:id="display"
               editable="false"
               prefHeight="80"
               prefWidth="310"
               GridPane.columnSpan="4"
               styleClass="display"/>

    <!-- Row 1: Control operations -->
    <Button text="CE" onAction="#handleButton"
            GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <Button text="C" onAction="#handleButton"
            GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Button text="⌫" onAction="#handleButton"
            GridPane.rowIndex="1" GridPane.columnIndex="2"/>
    <Button text="/" onAction="#handleButton"
            GridPane.rowIndex="1" GridPane.columnIndex="3"/>

    <!-- Row 2 -->
    <Button text="7" onAction="#handleButton"
            GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <Button text="8" onAction="#handleButton"
            GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Button text="9" onAction="#handleButton"
            GridPane.rowIndex="2" GridPane.columnIndex="2"/>
    <Button text="*" onAction="#handleButton"
            GridPane.rowIndex="2" GridPane.columnIndex="3"/>

    <!-- Row 3 -->
    <Button text="4" onAction="#handleButton"
            GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <Button text="5" onAction="#handleButton"
            GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    <Button text="6" onAction="#handleButton"
            GridPane.rowIndex="3" GridPane.columnIndex="2"/>
    <Button text="-" onAction="#handleButton"
            GridPane.rowIndex="3" GridPane.columnIndex="3"/>

    <!-- Row 4 -->
    <Button text="1" onAction="#handleButton"
            GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <Button text="2" onAction="#handleButton"
            GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    <Button text="3" onAction="#handleButton"
            GridPane.rowIndex="4" GridPane.columnIndex="2"/>
    <Button text="+" onAction="#handleButton"
            GridPane.rowIndex="4" GridPane.columnIndex="3"/>

    <!-- Row 5: Special + numeric -->
    <Button text="±" onAction="#handleButton"
            GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <Button text="0" onAction="#handleButton"
            GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    <Button text="." onAction="#handleButton"
            GridPane.rowIndex="5" GridPane.columnIndex="2"/>
    <Button text="=" onAction="#handleButton"
            GridPane.rowIndex="5" GridPane.columnIndex="3"/>

    <!--
        Grid configuration:
        Each column has fixed width to ensure:
        - perfect alignment between display and buttons
        - consistent calculator layout
        - predictable UI scaling behavior
    -->
    <columnConstraints>
        <ColumnConstraints prefWidth="70"/>
        <ColumnConstraints prefWidth="70"/>
        <ColumnConstraints prefWidth="70"/>
        <ColumnConstraints prefWidth="70"/>
    </columnConstraints>

</GridPane>